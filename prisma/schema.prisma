generator client {
  provider               = "prisma-client-js"
  output                 = "../generated/prisma"
  generatedFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

model File {
  id        String   @id @default(uuid())
  name      String
  uploadUrl String
  size      Int
  createdAt DateTime @default(now())
  userId    Int
  folderId  String?
  folder    Folder?  @relation(fields: [folderId], references: [id])
  user      User     @relation(fields: [userId], references: [id])
}

model Folder {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now())
  userId    Int
  files     File[]
  user      User     @relation(fields: [userId], references: [id])
}

model Session {
  id        String   @id
  sid       String   @unique
  data      String
  expiresAt DateTime
}

model User {
  id       Int      @id @default(autoincrement())
  username String   @unique
  password String
  files    File[]
  folders  Folder[]
}
